# =============================================================================
#  EMBARCACAO PIRATA  -  arquivo de configuracao
#  Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub.
# =============================================================================

# --- Servidor ---------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Endereco publico do site (sem barra no final). Aparece nas mensagens do WhatsApp.
URL_PUBLICA=https://seudominio.com.br

# --- Pix --------------------------------------------------------------------
# Chave Pix EXATA do Erick (CPF so numeros, telefone com DDI, e-mail ou chave aleatoria)
PIX_KEY=
# Nome do recebedor: ate 25 caracteres, sem acento
PIX_NOME=ERICK ZEBEDEU
# Cidade: ate 15 caracteres, sem acento
PIX_CIDADE=CARAVELAS

# --- WhatsApp do capitao ----------------------------------------------------
# DDI + DDD + numero, so digitos. Ex.: 5573999999999
CAPITAO_WHATSAPP=5573999999999
CAPITAO_NOME=Capitao Erick

# --- Painel administrativo --------------------------------------------------
ADMIN_USER=erick
# Senha usada APENAS no primeiro login, para criar o usuario.
# Depois que o sistema subir uma vez, APAGUE esta linha.
ADMIN_PASSWORD=
# Gere com:  openssl rand -hex 32
JWT_SECRET=
JWT_HORAS=8

# --- Inteligencia artificial local (Ollama) ---------------------------------
OLLAMA_ATIVO=true
# Dentro do Docker use http://ollama:11434 . Fora do Docker, http://127.0.0.1:11434
OLLAMA_URL=http://ollama:11434
# Modelo leve, cabe com folga nos 24 GB do Oracle ARM e responde em CPU.
# Se a maquina for menor, troque por qwen2.5:1.5b-instruct-q4_K_M
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_MAX_TOKENS=220
OLLAMA_TEMPERATURA=0.4
OLLAMA_TIMEOUT_MS=90000
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048

# --- Comportamento do robo --------------------------------------------------
WHATSAPP_ATIVO=true
# ATENCAO: o bot roda no numero PESSOAL do Erick.
#   palavra_chave = so responde sozinho a quem falar de passeio/reserva/preco
#                   ou a quem ja fez reserva no site.  (RECOMENDADO)
#   sempre        = responde a qualquer um que mandar mensagem.
#   nunca         = so avisos, nenhuma resposta automatica.
BOT_MODO_PADRAO=palavra_chave
# Quanto tempo o robo fica calado depois que o Erick digita numa conversa (minutos)
BOT_MINUTOS_HANDOFF=720
BOT_MAX_RESPOSTAS_HORA=12
# Numeros que o robo nunca deve responder (familia, socios), separados por virgula
BOT_NUMEROS_BLOQUEADOS=

# --- Upload de comprovantes -------------------------------------------------
UPLOAD_MAX_BYTES=5242880

# --- CORS -------------------------------------------------------------------
# Deixe vazio se o site e a API estao no mesmo dominio (caso normal).
CORS_ORIGENS=
